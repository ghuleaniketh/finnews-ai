# Application database (SQLite by default)
DATABASE_URL=sqlite:///./data/finnews.db

# External API Keys
FIRECRAWL_API_KEY=
GOOGLE_API_KEY=

# LLM & Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite
MEMENTO_LLM_PROVIDER=gemini
MEMENTO_EXTRACTION_MODEL=gemini-3.1-flash-lite
MEMENTO_TIEBREAKER_MODEL=gemini-3.1-flash-lite
MEMENTO_EMBEDDING_PROVIDER=gemini
MEMENTO_DB_PATH=./data/memento.db

# Server Configuration
CORS_ORIGINS=http://localhost:5173
MAX_ARTICLES=3
